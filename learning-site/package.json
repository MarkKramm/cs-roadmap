{
  "name": "cs-roadmap-learning-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal learning site that renders the career-roadmaps curriculum.",
  "scripts": {
    "build:content": "node ../scripts/build-content.mjs",
    "lint:content": "node ../scripts/lint-content.mjs",
    "test:search": "npm run build:content && node scripts/test-search.mjs",
    "test:smoke": "npm run build:content && node scripts/smoke-render.mjs",
    "test:highlight": "node scripts/test-highlight.mjs",
    "test:render-inline": "node scripts/test-render-inline.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:data": "node scripts/test-data.mjs",
    "test:lesson-search": "node scripts/test-lesson-search.mjs",
    "test:notes": "node scripts/test-notes.mjs",
    "test:work": "node scripts/test-work.mjs",
    "test:today": "node scripts/test-today.mjs",
    "test:phase-transfer": "node scripts/test-phase-transfer.mjs",
    "test:path-order": "node scripts/test-path-order.mjs",
    "test:quiz": "node scripts/test-quiz.mjs",
    "test:review": "node scripts/test-review.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test": "npm run test:render-inline && npm run test:highlight && npm run test:ui && npm run test:data && npm run test:notes && npm run test:work && npm run test:today && npm run test:lesson-search && npm run test:phase-transfer && npm run test:path-order && npm run test:quiz && npm run test:review && npm run test:search && npm run test:smoke",
    "dev": "npm run build:content && vite",
    "build": "npm run build:content && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}